{
  "name": "@bifravst/http-api-mock",
  "version": "0.0.0-development",
  "description": "Helper functions for AWS lambdas written in TypeScript.",
  "exports": {
    "./*": {
      "import": {
        "types": "./npm/*.d.ts",
        "default": "./npm/*.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "node --experimental-strip-types ./.npm/compile.ts && npx tsgo src/*.ts --emitDeclarationOnly --declaration --ignoreConfig --allowImportingTsExtensions --target esnext --module nodenext --moduleResolution nodenext --outDir ./npm && mv npm/src/* npm",
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules|e2e-tests|integration-tests)/**/*.spec.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bifravst/http-api-mock.git"
  },
  "bugs": {
    "url": "https://github.com/bifravst/http-api-mock/issues"
  },
  "homepage": "https://github.com/bifravst/http-api-mock",
  "keywords": [
    "aws",
    "lambda",
    "typescript"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "npm",
    "LICENSE",
    "README.md"
  ],
  "prettier": "@bifravst/prettier-config",
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.981.0",
    "@aws-sdk/client-dynamodb": "3.981.0",
    "@aws-sdk/client-sts": "3.981.0",
    "@aws-sdk/util-dynamodb": "3.981.0",
    "@bifravst/aws-cdk-lambda-helpers": "4.0.95",
    "@bifravst/cloudformation-helpers": "9.1.1",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/run": "1.2.0",
    "aws-cdk-lib": "2.251.0",
    "cdk": "2.1120.0",
    "chalk": "5.6.2",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@aws-cdk/toolkit-lib": "1.25.0",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "20.5.3",
    "@types/aws-lambda": "8.10.161",
    "@types/command-line-args": "5.2.3",
    "@types/node": "25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260309.1",
    "command-line-args": "6.0.2",
    "commitlint": "20.5.3",
    "husky": "9.1.7"
  }
}
